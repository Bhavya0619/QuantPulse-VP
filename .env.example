# ==============================================================================
# QuantPulse Platform: Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local Docker Compose or standalone development.
# NEVER COMMIT .env OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration
# ------------------------------------------------------------------------------
# Options: development | production | test
NODE_ENV=development
PORT=8000
# CORS allowed origins (use specific domain in production e.g. https://app.quantpulse.io)
CORS_ORIGIN=http://localhost:5173
# Logging format: pretty (human-readable) | json (structured for Grafana/Loki/CloudWatch)
LOG_FORMAT=pretty

# ------------------------------------------------------------------------------
# 2. Database & Cache Configuration
# ------------------------------------------------------------------------------
# In Docker Compose, use 'mongodb://mongodb:27017'
# In local host development, use 'mongodb://127.0.0.1:27017'
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=quantpulse

# Redis connection URL
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 3. Native C++20 Quantitative Engine
# ------------------------------------------------------------------------------
# Path to the compiled C++ quantpulse_cli binary
# In Docker containers: /usr/local/bin/quantpulse_cli
# Local Linux/macOS: ../cpp-engine/build-release/quantpulse_cli
# Local Windows: ../cpp-engine/build-release/Release/quantpulse_cli.exe
QUANTPULSE_ENGINE_PATH=../cpp-engine/build-release/quantpulse_cli

# ------------------------------------------------------------------------------
# 4. Market Data Feeds & Stock Exchange Providers
# ------------------------------------------------------------------------------
# Active provider: simulated | alphavantage | polygon | binance | zerodha | upstox | custom_webhook
MARKET_DATA_PROVIDER=simulated

# Alpha Vantage API Key (https://www.alphavantage.co/)
ALPHA_VANTAGE_API_KEY=

# Polygon.io API Key (https://polygon.io/)
POLYGON_API_KEY=

# Binance Spot Exchange (https://binance.com)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Zerodha Kite Connect (https://kite.trade/)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Upstox Pro API (https://upstox.com/developer/api-documentation/)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Custom Proprietary Exchange Webhook / REST Bridge
CUSTOM_EXCHANGE_WEBHOOK_URL=
CUSTOM_EXCHANGE_API_KEY=

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Backend API Base URL (leave empty to use relative /api with Nginx reverse proxy)
VITE_API_BASE_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000
VITE_DEFAULT_SYMBOL=RELIANCE

# ------------------------------------------------------------------------------
# 6. Observability & Monitoring (Grafana / Prometheus)
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=quantpulse
HTTP_PORT=80